# Copy to .env to override defaults (docker compose reads it automatically).
# Every value below is the default.

# --- connections (compose sets these for containers; these are for running on the host) ---
REDIS_URL=redis://localhost:6379/0
SUPPLIER_URL=http://localhost:8001
SUPPLIER_TIMEOUT_S=3.0
REDIS_MAX_CONNECTIONS=200

# --- cache ---
CACHE_SEARCH_TTL_S=600        # search results: 10 min
CACHE_DETAILS_TTL_S=86400     # hotel details: 24 h
CACHE_STALE_TTL_S=604800      # last-known-good fallback copy: 7 days

# --- rate limit (token bucket per client id) ---
RATE_LIMIT_BURST=30
RATE_LIMIT_PER_S=10

# --- circuit breaker ---
BREAKER_FAILURE_THRESHOLD=5   # failures ...
BREAKER_WINDOW_S=30           # ... within this window open the breaker
BREAKER_COOLDOWN_S=15         # wait before one probe request is let through

# --- load shedding / server ---
SUPPLIER_MAX_INFLIGHT=40      # concurrent supplier calls per worker
MCP_WORKERS=4                 # HTTP worker processes
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,mcp:*
LOG_LEVEL=INFO

# --- mock supplier ---
SUPPLIER_LATENCY_MIN_MS=300
SUPPLIER_LATENCY_MAX_MS=800

# --- load test (make spike) ---
SPIKE_USERS=500
SPIKE_RAMP_S=20
SPIKE_HOLD_S=60
